{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/social-memory/capture-export-v1.schema.json",
  "title": "Social Memory Capture Export v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "captures"],
  "properties": {
    "schema": { "const": "social-memory.capture-export" },
    "version": { "const": 1 },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "nativeKind", "source"],
        "properties": {
          "kind": { "enum": ["like", "save", "repost", "manual"] },
          "nativeKind": { "type": "string", "minLength": 1 },
          "capturedAt": { "type": ["string", "null"], "format": "date-time" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["externalId"],
            "properties": {
              "externalId": { "type": "string", "minLength": 1 },
              "canonicalUrl": { "type": ["string", "null"], "format": "uri" },
              "author": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "handle": { "type": ["string", "null"] },
                  "name": { "type": ["string", "null"] }
                }
              },
              "text": { "type": ["string", "null"] },
              "sourceCreatedAt": { "type": ["string", "null"], "format": "date-time" }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "text", "provenance"],
                  "properties": {
                    "kind": { "const": "text" },
                    "text": { "type": "string", "minLength": 1 },
                    "provenance": { "type": "string", "minLength": 1 },
                    "sourceUrl": { "type": "string", "format": "uri" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "path", "provenance"],
                  "properties": {
                    "kind": { "const": "file" },
                    "path": { "type": "string", "minLength": 1 },
                    "mimeType": { "type": "string" },
                    "provenance": { "type": "string", "minLength": 1 },
                    "sourceUrl": { "type": "string", "format": "uri" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
